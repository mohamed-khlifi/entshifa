# =============================================================================
# EntShifa local environment (copy to `.env` — never commit `.env`)
# =============================================================================

# ---- Compose ----
COMPOSE_PROJECT_NAME=entshifa

# ---- Application ----
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- MySQL 8 ----
# Use 127.0.0.1 on Windows if localhost hits another MySQL (e.g. XAMPP on ::1).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=entshifa
MYSQL_USER=entshifa
MYSQL_PASSWORD=local_dev_mysql_password_change_me
MYSQL_ROOT_PASSWORD=local_dev_mysql_root_change_me
# Async SQLAlchemy URL (API uses aiomysql in later tickets)
DATABASE_URL=mysql+aiomysql://entshifa:local_dev_mysql_password_change_me@127.0.0.1:3306/entshifa?charset=utf8mb4

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (MinIO locally, S3-compatible in staging/prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=entshifa_minio_access_key
S3_SECRET_ACCESS_KEY=local_dev_minio_secret_change_me
S3_BUCKET=entshifa-clinical
MINIO_ROOT_USER=entshifa_minio_access_key
MINIO_ROOT_PASSWORD=local_dev_minio_secret_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# STORAGE_BACKEND=s3 (default) or local (filesystem for unit tests)
# LOCAL_STORAGE_ROOT=/tmp/entshifa-storage
# ATTACHMENT_UPLOAD_URL_TTL_SECONDS=900
# ATTACHMENT_DOWNLOAD_URL_TTL_SECONDS=300

# ---- Auth (dummy values for local dev only; rotate in real environments) ----
JWT_ISSUER=entshifa-local
JWT_AUDIENCE=entshifa-api
ACCESS_TOKEN_SECRET=local_dev_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=local_dev_refresh_token_secret_min_32_chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- Security / crypto ----
FIELD_ENCRYPTION_KEY=local_dev_field_encryption_key_32b_base64==

# ---- Email / SMS (optional in local; wired in later tickets) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.local
SMS_PROVIDER=

# ---- Observability (optional locally) ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
